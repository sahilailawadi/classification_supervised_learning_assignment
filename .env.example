# LLM Configuration
# Set LLM_MODE to either "academic" or "work"
LLM_MODE=academic

# ============================================================
# ACADEMIC MODE - OpenAI Configuration
# ============================================================
# Required for academic mode (assignments, presentations)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================
# WORK MODE - LLM Gateway Configuration
# ============================================================
# Required for work mode (production analysis with live DB)
WORK_LLM_ENDPOINT=https://llm-gateway.company.com/v1
WORK_LLM_API_KEY=your-work-gateway-api-key-here
WORK_LLM_MODEL=default

# ============================================================
# Database Configuration (for WORK mode)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=performance_tests
DB_USER=your_username
DB_PASSWORD=your_password
