# LLM Configuration
# Set LLM_MODE to either "academic" or "work"
LLM_MODE=academic

# ============================================================
# ACADEMIC MODE - OpenAI Configuration
# ============================================================
# Required for academic mode (assignments, presentations)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================
# WORK MODE - LLM Gateway Configuration
# ============================================================
# Required for work mode (production analysis with live DB)
WORK_LLM_ENDPOINT=https://api.context.flow.cnap.comcast.net/modelgw/models/openai/v1
WORK_LLM_MODEL=gpt-4

# OAuth Configuration (SAT)
SAT_OAUTH_URL=https://sat-prod.codebig2.net/v2/oauth/token
SAT_CLIENT_ID=your-client-id
SAT_CLIENT_SECRET=your-client-secret
SAT_GRANT_TYPE=client_credentials

# ============================================================
# Database Configuration (for WORK mode)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=performance_tests
DB_USER=your_username
DB_PASSWORD=your_password
